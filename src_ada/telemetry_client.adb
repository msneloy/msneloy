with Ada.Text_IO;

package body Telemetry_Client is
   procedure Emit_JS (Path : String) is
      use Ada.Text_IO;
      F : File_Type;
   begin
      Create (F, Out_File, Path);
      Put_Line (F, """use strict"";");
      Put_Line (F, "const shareBase = ""https://wakatime.com/share/@Sierra117/"";");
      Put_Line (F, "const feeds = {");
      Put_Line (F, "    summary: ""ca964aaa-fcd3-4f9b-ad9b-855b90cb5ae4"",");
      Put_Line (F, "    languages: ""bb9729ad-9cb3-4d6c-b912-359e136ed48a"",");
      Put_Line (F, "    frameworks: """",");
      Put_Line (F, "    editors: ""7cab5d5a-187a-4687-9e05-db05c975bf68"",");
      Put_Line (F, "    systems: ""8bb890bb-0128-4bb0-adaa-def4d63aa689"",");
      Put_Line (F, "    categories: ""bdfc68ea-2e02-4fef-8870-5f648645152a"",");
      Put_Line (F, "};");
      Put_Line (F, "const ignoredNames = new Set([""other"", ""unknown""]);");
      Put_Line (F, "const nameAliases = {");
      Put_Line (F, "    Browser: ""Brave"",");
      Put_Line (F, "    ""Unknown Editor"": ""Ghost Mode"",");
      Put_Line (F, "    Other: ""Unmapped Runtime"",");
      Put_Line (F, "    Unknown: ""Unmapped Runtime"",");
      Put_Line (F, "    ""Unknown Language"": ""Unmapped Runtime"",");
      Put_Line (F, "    ""Unknown OS"": ""Android"",");
      Put_Line (F, "};");
      Put_Line (F, "const categoryColors = [");
      Put_Line (F, "    ""#f04455"",");
      Put_Line (F, "    ""#42b9c8"",");
      Put_Line (F, "    ""#f0b64a"",");
      Put_Line (F, "    ""#9584ef"",");
      Put_Line (F, "    ""#71c98d"",");
      Put_Line (F, "    ""#ed7f55"",");
      Put_Line (F, "    ""#58a4e0"",");
      Put_Line (F, "    ""#e879b0"",");
      Put_Line (F, "];");
      Put_Line (F, "const editorColors = [");
      Put_Line (F, "    ""#f04455"",");
      Put_Line (F, "    ""#42b9c8"",");
      Put_Line (F, "    ""#f0b64a"",");
      Put_Line (F, "    ""#9584ef"",");
      Put_Line (F, "    ""#71c98d"",");
      Put_Line (F, "    ""#ed7f55"",");
      Put_Line (F, "    ""#58a4e0"",");
      Put_Line (F, "    ""#e879b0"",");
      Put_Line (F, "    ""#b4d94e"",");
      Put_Line (F, "    ""#aab8c5"",");
      Put_Line (F, "];");
      Put_Line (F, "const axisMultipliers = [1, 1.25, 1.5, 2, 2.5, 3, 4, 5, 6, 7.5];");
      Put_Line (F, "const axisTickMultipliers = [1, 2, 5];");
      Put_Line (F, "const operatingSystemColors = [");
      Put_Line (F, "    ""#f04455"",");
      Put_Line (F, "    ""#e9a343"",");
      Put_Line (F, "    ""#43b9c8"",");
      Put_Line (F, "    ""#7187e8"",");
      Put_Line (F, "    ""#70bd83"",");
      Put_Line (F, "];");
      Put_Line (F, "function escapeHtml(value) {");
      Put_Line (F, "    return String(value).replace(/[&<>""']/g, (character) => ({");
      Put_Line (F, "        ""&"": ""&amp;"",");
      Put_Line (F, "        ""<"": ""&lt;"",");
      Put_Line (F, "        "">"": ""&gt;"",");
      Put_Line (F, "        '""': ""&quot;"",");
      Put_Line (F, "        ""'"": ""&#39;"",");
      Put_Line (F, "    })[character]);");
      Put_Line (F, "}");
      Put_Line (F, "function formatAxisTick(hours) {");
      Put_Line (F, "    return `${new Intl.NumberFormat(""en-US"", { maximumSignificantDigits: 3, useGrouping: false }).format(hours)}h`;");
      Put_Line (F, "}");
      Put_Line (F, "function record(value, label) {");
      Put_Line (F, "    if (typeof value !== ""object"" || value === null || Array.isArray(value)) {");
      Put_Line (F, "        throw new Error(`WakaTime returned an invalid ${label} response.`);");
      Put_Line (F, "    }");
      Put_Line (F, "    return value;");
      Put_Line (F, "}");
      Put_Line (F, "function requiredText(source, key, label) {");
      Put_Line (F, "    const value = source[key];");
      Put_Line (F, "    if (typeof value !== ""string"" || !value.trim()) {");
      Put_Line (F, "        throw new Error(`WakaTime response is missing ${label}.`);");
      Put_Line (F, "    }");
      Put_Line (F, "    return value;");
      Put_Line (F, "}");
      Put_Line (F, "function formatDuration(seconds) {");
      Put_Line (F, "    const wholeSeconds = Math.max(0, Math.floor(seconds));");
      Put_Line (F, "    const hours = Math.floor(wholeSeconds / 3600);");
      Put_Line (F, "    const minutes = Math.floor((wholeSeconds % 3600) / 60);");
      Put_Line (F, "    const secs = wholeSeconds % 60;");
      Put_Line (F, "    return `${hours.toString().padStart(2, ""0"")}:${minutes");
      Put_Line (F, "        .toString()");
      Put_Line (F, "        .padStart(2, ""0"")}:${secs.toString().padStart(2, ""0"")}`;");
      Put_Line (F, "}");
      Put_Line (F, "function formatSummaryDuration(seconds) {");
      Put_Line (F, "    const wholeSeconds = Math.max(0, Math.floor(seconds));");
      Put_Line (F, "    const hours = Math.floor(wholeSeconds / 3600);");
      Put_Line (F, "    const minutes = Math.floor((wholeSeconds % 3600) / 60);");
      Put_Line (F, "    return `${hours.toLocaleString()}H ${minutes.toString().padStart(2, ""0"")}M`;");
      Put_Line (F, "}");
      Put_Line (F, "function parseItems(value, label, limit = Infinity) {");
      Put_Line (F, "    if (!Array.isArray(value)) {");
      Put_Line (F, "        throw new Error(`WakaTime returned invalid ${label} data.`);");
      Put_Line (F, "    }");
      Put_Line (F, "    const items = value");
      Put_Line (F, "        .map((entry) => {");
      Put_Line (F, "        if (typeof entry !== ""object"" || entry === null || Array.isArray(entry))");
      Put_Line (F, "            return null;");
      Put_Line (F, "        const item = entry;");
      Put_Line (F, "        const sourceName = typeof item.name === ""string"" ? item.name.trim() : """";");
      Put_Line (F, "        const name = nameAliases[sourceName] ?? sourceName;");
      Put_Line (F, "        const totalSeconds = Number(item.total_seconds);");
      Put_Line (F, "        const percent = Number(item.percent);");
      Put_Line (F, "        const color = typeof item.color === ""string"" && item.color.trim()");
      Put_Line (F, "            ? item.color.trim()");
      Put_Line (F, "            : undefined;");
      Put_Line (F, "        // Filter out invalid entries, unmapped runtime for languages, and anything with 0 min (< 60s)");
      Put_Line (F, "        if (!name ||");
      Put_Line (F, "            (label === ""languages"" && name === ""Unmapped Runtime"") ||");
      Put_Line (F, "            !Number.isFinite(totalSeconds) ||");
      Put_Line (F, "            totalSeconds < 60 ||");
      Put_Line (F, "            Math.floor(totalSeconds / 60) <= 0 ||");
      Put_Line (F, "            !Number.isFinite(percent) ||");
      Put_Line (F, "            percent < 0)");
      Put_Line (F, "            return null;");
      Put_Line (F, "        if (ignoredNames.has(name.toLowerCase()))");
      Put_Line (F, "            return null;");
      Put_Line (F, "        return {");
      Put_Line (F, "            name,");
      Put_Line (F, "            percent: Math.min(percent, 100),");
      Put_Line (F, "            totalSeconds,");
      Put_Line (F, "            text: formatDuration(totalSeconds),");
      Put_Line (F, "            color,");
      Put_Line (F, "        };");
      Put_Line (F, "    })");
      Put_Line (F, "        .filter((item) => item !== null);");
      Put_Line (F, "    // Sort alphabetically by name (case-insensitive)");
      Put_Line (F, "    const ordered = items.sort((a, b) => a.name.localeCompare(b.name, undefined, { sensitivity: ""base"" }));");
      Put_Line (F, "    return limit === Infinity ? ordered : ordered.slice(0, limit);");
      Put_Line (F, "}");
      Put_Line (F, "async function fetchFeed(id) {");
      Put_Line (F, "    const response = await fetch(`${shareBase}${id}.json`, { cache: ""no-store"" });");
      Put_Line (F, "    if (!response.ok)");
      Put_Line (F, "        throw new Error(`WakaTime request failed (${response.status}).`);");
      Put_Line (F, "    return response.json();");
      Put_Line (F, "}");
      Put_Line (F, "async function loadDashboard() {");
      Put_Line (F, "    const [summaryResponse, languagesResponse, editorsResponse, systemsResponse, categoriesResponse, frameworksResponse,] = await Promise.all([");
      Put_Line (F, "        fetchFeed(feeds.summary),");
      Put_Line (F, "        fetchFeed(feeds.languages),");
      Put_Line (F, "        fetchFeed(feeds.editors),");
      Put_Line (F, "        fetchFeed(feeds.systems),");
      Put_Line (F, "        fetchFeed(feeds.categories),");
      Put_Line (F, "        feeds.frameworks");
      Put_Line (F, "            ? fetchFeed(feeds.frameworks).catch(() => null)");
      Put_Line (F, "            : Promise.resolve(null),");
      Put_Line (F, "    ]);");
      Put_Line (F, "    const summaryPayload = record(summaryResponse, ""summary"");");
      Put_Line (F, "    const summary = record(summaryPayload.data, ""summary data"");");
      Put_Line (F, "    const grandTotal = record(summary.grand_total, ""summary totals"");");
      Put_Line (F, "    const range = record(summary.range, ""summary date range"");");
      Put_Line (F, "    const bestDay = record(summary.best_day, ""best-day"");");
      Put_Line (F, "    const totalSeconds = Number(grandTotal.total_seconds_including_other_language ??");
      Put_Line (F, "        grandTotal.total_seconds ??");
      Put_Line (F, "        0);");
      Put_Line (F, "    const dailyAverageSeconds = Number(grandTotal.daily_average_including_other_language ??");
      Put_Line (F, "        grandTotal.daily_average ??");
      Put_Line (F, "        0);");
      Put_Line (F, "    const bestDaySeconds = Number(bestDay.total_seconds ?? 0);");
      Put_Line (F, "    const languagePayload = record(languagesResponse, ""language"");");
      Put_Line (F, "    const editorPayload = record(editorsResponse, ""editor"");");
      Put_Line (F, "    const systemPayload = record(systemsResponse, ""operating-system"");");
      Put_Line (F, "    const categoryPayload = record(categoriesResponse, ""category"");");
      Put_Line (F, "    const rangeStart = requiredText(range, ""start"", ""the tracking start date"");");
      Put_Line (F, "    const rangeEnd = requiredText(range, ""end"", ""the latest tracking date"");");
      Put_Line (F, "    const days = Number(range.days_including_holidays);");
      Put_Line (F, "    if (!Number.isFinite(days))");
      Put_Line (F, "        throw new Error(""WakaTime returned an invalid tracked-day count."");");
      Put_Line (F, "    const languagesList = parseItems(languagePayload.data, ""languages"");");
      Put_Line (F, "    const frameworksList = frameworksResponse && typeof frameworksResponse === ""object""");
      Put_Line (F, "        ? parseItems(record(frameworksResponse, ""frameworks"").data, ""frameworks"")");
      Put_Line (F, "        : [];");
      Put_Line (F, "    const combinedLanguageMap = new Map();");
      Put_Line (F, "    for (const item of [...languagesList, ...frameworksList]) {");
      Put_Line (F, "        const existing = combinedLanguageMap.get(item.name);");
      Put_Line (F, "        if (existing) {");
      Put_Line (F, "            existing.totalSeconds += item.totalSeconds;");
      Put_Line (F, "            existing.percent = Math.min(100, existing.percent + item.percent);");
      Put_Line (F, "            existing.text = formatDuration(existing.totalSeconds);");
      Put_Line (F, "            if (!existing.color && item.color)");
      Put_Line (F, "                existing.color = item.color;");
      Put_Line (F, "        }");
      Put_Line (F, "        else {");
      Put_Line (F, "            combinedLanguageMap.set(item.name, { ...item });");
      Put_Line (F, "        }");
      Put_Line (F, "    }");
      Put_Line (F, "    const combinedLanguages = Array.from(combinedLanguageMap.values()).sort((a, b) => a.name.localeCompare(b.name, undefined, { sensitivity: ""base"" }));");
      Put_Line (F, "    return {");
      Put_Line (F, "        summary: {");
      Put_Line (F, "            total: Number.isFinite(totalSeconds)");
      Put_Line (F, "                ? formatSummaryDuration(totalSeconds)");
      Put_Line (F, "                : requiredText(grandTotal, ""human_readable_total_including_other_language"", ""the total tracked time""),");
      Put_Line (F, "            dailyAverage: Number.isFinite(dailyAverageSeconds)");
      Put_Line (F, "                ? formatSummaryDuration(dailyAverageSeconds)");
      Put_Line (F, "                : requiredText(grandTotal, ""human_readable_daily_average"", ""the daily average""),");
      Put_Line (F, "            bestDay: {");
      Put_Line (F, "                date: requiredText(bestDay, ""date"", ""the best-day date""),");
      Put_Line (F, "                text: Number.isFinite(bestDaySeconds)");
      Put_Line (F, "                    ? formatSummaryDuration(bestDaySeconds)");
      Put_Line (F, "                    : requiredText(bestDay, ""text"", ""the best-day duration""),");
      Put_Line (F, "            },");
      Put_Line (F, "            start: rangeStart.slice(0, 10),");
      Put_Line (F, "            end: rangeEnd.slice(0, 10),");
      Put_Line (F, "            days,");
      Put_Line (F, "        },");
      Put_Line (F, "        languages: combinedLanguages,");
      Put_Line (F, "        editors: parseItems(editorPayload.data, ""editors""),");
      Put_Line (F, "        systems: parseItems(systemPayload.data, ""operating systems""),");
      Put_Line (F, "        categories: parseItems(categoryPayload.data, ""categories"", 8),");
      Put_Line (F, "    };");
      Put_Line (F, "}");
      Put_Line (F, "function logAxisCeiling(items, fillRatio = 0.92) {");
      Put_Line (F, "    const maxHours = Math.max(...items.map((item) => item.totalSeconds / 3600), 0);");
      Put_Line (F, "    if (maxHours <= 0)");
      Put_Line (F, "        return 1;");
      Put_Line (F, "    const logMax = Math.log10(1 + maxHours);");
      Put_Line (F, "    let base = 0.1;");
      Put_Line (F, "    while (true) {");
      Put_Line (F, "        for (const multiplier of axisMultipliers) {");
      Put_Line (F, "            const ceiling = base * multiplier;");
      Put_Line (F, "            if (ceiling < maxHours)");
      Put_Line (F, "                continue;");
      Put_Line (F, "            if (logMax / Math.log10(1 + ceiling) <= fillRatio)");
      Put_Line (F, "                return ceiling;");
      Put_Line (F, "        }");
      Put_Line (F, "        base *= 10;");
      Put_Line (F, "    }");
      Put_Line (F, "}");
      Put_Line (F, "function logScaleTicks(items, minRatioGap) {");
      Put_Line (F, "    const ceiling = logAxisCeiling(items);");
      Put_Line (F, "    const logCeiling = Math.log10(1 + ceiling);");
      Put_Line (F, "    const values = [];");
      Put_Line (F, "    for (let base = 0.1; base <= ceiling * 1.0001; base *= 10) {");
      Put_Line (F, "        for (const multiplier of axisTickMultipliers) {");
      Put_Line (F, "            const value = base * multiplier;");
      Put_Line (F, "            if (value <= ceiling * 1.0001)");
      Put_Line (F, "                values.push(value);");
      Put_Line (F, "        }");
      Put_Line (F, "    }");
      Put_Line (F, "    if (!values.length || values[values.length - 1] < ceiling * 0.9999)");
      Put_Line (F, "        values.push(ceiling);");
      Put_Line (F, "    const filtered = [];");
      Put_Line (F, "    for (const value of values) {");
      Put_Line (F, "        const position = Math.log10(1 + value) / logCeiling;");
      Put_Line (F, "        const previousPosition = filtered.length");
      Put_Line (F, "            ? Math.log10(1 + filtered[filtered.length - 1]) / logCeiling");
      Put_Line (F, "            : 0;");
      Put_Line (F, "        if (!filtered.length || position - previousPosition >= minRatioGap)");
      Put_Line (F, "            filtered.push(value);");
      Put_Line (F, "    }");
      Put_Line (F, "    if (filtered[filtered.length - 1] < ceiling * 0.9999)");
      Put_Line (F, "        filtered.push(ceiling);");
      Put_Line (F, "    return filtered.map((value) => ({");
      Put_Line (F, "        value,");
      Put_Line (F, "        position: (Math.log10(1 + value) / logCeiling) * 100,");
      Put_Line (F, "    }));");
      Put_Line (F, "}");
      Put_Line (F, "function logBarWidth(item, items) {");
      Put_Line (F, "    const hours = item.totalSeconds / 3600;");
      Put_Line (F, "    const axis = logAxisCeiling(items);");
      Put_Line (F, "    return Math.max(2, (Math.log10(1 + hours) / Math.log10(1 + axis)) * 100);");
      Put_Line (F, "}");
      Put_Line (F, "function linearAxis(items) {");
      Put_Line (F, "    const maxHours = Math.max(...items.map((item) => item.totalSeconds / 3600), 0);");
      Put_Line (F, "    if (maxHours <= 0)");
      Put_Line (F, "        return 1;");
      Put_Line (F, "    const roughStep = maxHours / 4;");
      Put_Line (F, "    const magnitude = 10 ** Math.floor(Math.log10(roughStep));");
      Put_Line (F, "    const normalizedStep = roughStep / magnitude;");
      Put_Line (F, "    const step = (normalizedStep <= 1");
      Put_Line (F, "        ? 1");
      Put_Line (F, "        : normalizedStep <= 2");
      Put_Line (F, "            ? 2");
      Put_Line (F, "            : normalizedStep <= 5");
      Put_Line (F, "                ? 5");
      Put_Line (F, "                : 10) * magnitude;");
      Put_Line (F, "    return Math.ceil(maxHours / step) * step;");
      Put_Line (F, "}");
      Put_Line (F, "function categoryGradient(items) {");
      Put_Line (F, "    let cursor = 0;");
      Put_Line (F, "    const stops = items.map((item, index) => {");
      Put_Line (F, "        const start = cursor;");
      Put_Line (F, "        cursor += item.percent;");
      Put_Line (F, "        return `${categoryColors[index % categoryColors.length]} ${start}% ${cursor}%`;");
      Put_Line (F, "    });");
      Put_Line (F, "    if (cursor < 100)");
      Put_Line (F, "        stops.push(`#293746 ${cursor}% 100%`);");
      Put_Line (F, "    return `conic-gradient(${stops.join("", "")})`;");
      Put_Line (F, "}");
      Put_Line (F, "function summaryMarkup(summary) {");
      Put_Line (F, "    return `");
      Put_Line (F, "    <article class=""instrument-card"">");
      Put_Line (F, "      <p class=""card-label"">TOTAL LOGGED</p>");
      Put_Line (F, "      <strong>${escapeHtml(summary.total)}</strong>");
      Put_Line (F, "      <span class=""card-index"">CAREER HOURS</span>");
      Put_Line (F, "    </article>");
      Put_Line (F, "    <article class=""instrument-card"">");
      Put_Line (F, "      <p class=""card-label"">DAILY AVERAGE</p>");
      Put_Line (F, "      <strong>${escapeHtml(summary.dailyAverage)}</strong>");
      Put_Line (F, "      <span class=""card-index"">ALL TRACKED DAYS</span>");
      Put_Line (F, "    </article>");
      Put_Line (F, "    <article class=""instrument-card"">");
      Put_Line (F, "      <p class=""card-label"">PEAK OUTPUT</p>");
      Put_Line (F, "      <strong>${escapeHtml(summary.bestDay.text)}</strong>");
      Put_Line (F, "      <span class=""card-index"">${escapeHtml(summary.bestDay.date)}</span>");
      Put_Line (F, "    </article>");
      Put_Line (F, "    <article class=""instrument-card"">");
      Put_Line (F, "      <p class=""card-label"">TRACKING WINDOW</p>");
      Put_Line (F, "      <strong>${summary.days.toLocaleString()} <small>DAYS</small></strong>");
      Put_Line (F, "      <span class=""card-index"">${escapeHtml(summary.start)} — ${escapeHtml(summary.end)}</span>");
      Put_Line (F, "    </article>`;");
      Put_Line (F, "}");
      Put_Line (F, "function languageMarkup(items) {");
      Put_Line (F, "    const ceiling = linearAxis(items);");
      Put_Line (F, "    const rows = items");
      Put_Line (F, "        .map((item) => `");
      Put_Line (F, "    <li class=""data-row"">");
      Put_Line (F, "      <div class=""row-heading""><span>${escapeHtml(item.name)}</span><span class=""row-value"">${formatDuration(item.totalSeconds)}<b>${item.percent.toFixed(2)}%</b></span></div>");
      Put_Line (F, "      <div class=""bar-track linear-track"" role=""meter"" aria-label=""${escapeHtml(`${item.name}: ${formatDuration(item.totalSeconds)}`)}"" aria-valuemin=""0"" aria-valuemax=""${ceiling}"" aria-valuenow=""${item.totalSeconds / 3600}"">");
      Put_Line (F, "        <span class=""bar-fill"" style=""--bar-width: ${Math.max(1, (item.totalSeconds / 3600 / ceiling) * 100)}%""></span>");
      Put_Line (F, "      </div>");
      Put_Line (F, "    </li>`)");
      Put_Line (F, "        .join("""");");
      Put_Line (F, "    return `");
      Put_Line (F, "    <article class=""dashboard-panel language-panel"">");
      Put_Line (F, "      <header class=""panel-heading"">");
      Put_Line (F, "        <div><p class=""panel-kicker"">02 / DISTRIBUTION</p><h2>Languages &amp; Frameworks</h2></div>");
      Put_Line (F, "        <span class=""panel-meta"">${items.length} TRACKED</span>");
      Put_Line (F, "      </header>");
      Put_Line (F, "      ${items.length ? `<ol class=""data-list"">${rows}</ol>` : '<p class=""empty-data"">No language or framework activity was reported for this range.</p>'}");
      Put_Line (F, "    </article>`;");
      Put_Line (F, "}");
      Put_Line (F, "function editorMarkup(items) {");
      Put_Line (F, "    const ticks = logScaleTicks(items, 0.12);");
      Put_Line (F, "    const axis = ticks");
      Put_Line (F, "        .map((tick) => `<span style=""--tick-position: ${tick.position}%"">${formatAxisTick(tick.value)}</span>`)");
      Put_Line (F, "        .join("""");");
      Put_Line (F, "    const gridlines = ticks");
      Put_Line (F, "        .map((tick) => `<i class=""vertical-gridline"" style=""--tick-position: ${tick.position}%""></i>`)");
      Put_Line (F, "        .join("""");");
      Put_Line (F, "    const bars = items");
      Put_Line (F, "        .map((item, index) => {");
      Put_Line (F, "        const color = item.color || editorColors[index % editorColors.length];");
      Put_Line (F, "        return `");
      Put_Line (F, "    <div class=""vertical-bar-column"" title=""${escapeHtml(`${item.name}: ${formatDuration(item.totalSeconds)}`)}"">");
      Put_Line (F, "      <span class=""vertical-bar"" style=""--bar-height: ${logBarWidth(item, items)}%; --editor-color: ${color}""></span>");
      Put_Line (F, "    </div>`;");
      Put_Line (F, "    })");
      Put_Line (F, "        .join("""");");
      Put_Line (F, "    const legend = items");
      Put_Line (F, "        .map((item, index) => {");
      Put_Line (F, "        const color = item.color || editorColors[index % editorColors.length];");
      Put_Line (F, "        return `");
      Put_Line (F, "    <li>");
      Put_Line (F, "      <span class=""editor-swatch"" style=""--editor-color: ${color}"" aria-hidden=""true""></span>");
      Put_Line (F, "      <span>${escapeHtml(item.name)}</span>");
      Put_Line (F, "      <strong>${formatDuration(item.totalSeconds)}</strong>");
      Put_Line (F, "    </li>`;");
      Put_Line (F, "    })");
      Put_Line (F, "        .join("""");");
      Put_Line (F, "    return `");
      Put_Line (F, "    <article class=""dashboard-panel editor-panel"">");
      Put_Line (F, "      <header class=""panel-heading"">");
      Put_Line (F, "        <div><p class=""panel-kicker"">03 / WORKSTATIONS</p><h2>Editors</h2></div>");
      Put_Line (F, "        <span class=""panel-meta"">${items.length} TRACKED</span>");
      Put_Line (F, "      </header>");
      Put_Line (F, "      ${items.length");
      Put_Line (F, "        ? `");
      Put_Line (F, "        <div class=""vertical-chart"">");
      Put_Line (F, "          <div class=""vertical-axis"" aria-hidden=""true"">${axis}</div>");
      Put_Line (F, "          <div class=""vertical-plot"" role=""img"" aria-label=""Editor activity, vertical log-scale bars; alphabetical order"">");
      Put_Line (F, "            ${gridlines}<div class=""vertical-bars"">${bars}</div>");
      Put_Line (F, "          </div>");
      Put_Line (F, "        </div>");
      Put_Line (F, "        <ol class=""editor-legend"">${legend}</ol>`");
      Put_Line (F, "        : '<p class=""empty-data"">No editor activity was reported for this range.</p>'}");
      Put_Line (F, "    </article>`;");
      Put_Line (F, "}");
      Put_Line (F, "function systemsMarkup(items) {");
      Put_Line (F, "    const segments = items");
      Put_Line (F, "        .map((item, index) => `");
      Put_Line (F, "    <span class=""os-segment"" style=""--segment-width: ${osShare(item, items)}%; --segment-color: ${operatingSystemColors[index % operatingSystemColors.length]}""></span>`)");
      Put_Line (F, "        .join("""");");
      Put_Line (F, "    const legend = items");
      Put_Line (F, "        .map((item, index) => `");
      Put_Line (F, "    <li>");
      Put_Line (F, "      <span class=""os-swatch"" style=""--segment-color: ${operatingSystemColors[index % operatingSystemColors.length]}""></span>");
      Put_Line (F, "      <span class=""os-name"">${escapeHtml(item.name)}</span>");
      Put_Line (F, "      <span class=""os-percent"">${item.percent.toFixed(2)}%</span>");
      Put_Line (F, "      <strong>${formatDuration(item.totalSeconds)}</strong>");
      Put_Line (F, "    </li>`)");
      Put_Line (F, "        .join("""");");
      Put_Line (F, "    const chartLabel = items");
      Put_Line (F, "        .map((item) => `${item.name} ${item.percent.toFixed(2)}%`)");
      Put_Line (F, "        .map(escapeHtml)");
      Put_Line (F, "        .join("", "");");
      Put_Line (F, "    return `");
      Put_Line (F, "    <article class=""dashboard-panel systems-panel"">");
      Put_Line (F, "      <header class=""panel-heading"">");
      Put_Line (F, "        <div><p class=""panel-kicker"">04 / ENVIRONMENT</p><h2>Operating systems</h2></div>");
      Put_Line (F, "        <span class=""panel-meta"">${items.length} TRACKED</span>");
      Put_Line (F, "      </header>");
      Put_Line (F, "      ${items.length");
      Put_Line (F, "        ? `");
      Put_Line (F, "        <div class=""os-chart"" role=""group"" aria-label=""Operating system distribution"">");
      Put_Line (F, "          <div class=""os-stacked-bar"" role=""img"" aria-label=""${chartLabel}"">${segments}</div>");
      Put_Line (F, "          <ol class=""os-legend"">${legend}</ol>");
      Put_Line (F, "        </div>`");
      Put_Line (F, "        : '<p class=""empty-data"">No operating-system activity was reported for this range.</p>'}");
      Put_Line (F, "    </article>`;");
      Put_Line (F, "}");
      Put_Line (F, "function osShare(item, items) {");
      Put_Line (F, "    const total = items.reduce((sum, entry) => sum + entry.totalSeconds, 0);");
      Put_Line (F, "    return total ? (item.totalSeconds / total) * 100 : 0;");
      Put_Line (F, "}");
      Put_Line (F, "function categoriesMarkup(items) {");
      Put_Line (F, "    const legend = items");
      Put_Line (F, "        .map((item, index) => `");
      Put_Line (F, "    <li>");
      Put_Line (F, "      <span class=""category-swatch"" style=""--swatch: ${categoryColors[index % categoryColors.length]}""></span>");
      Put_Line (F, "      <span class=""category-name"">${escapeHtml(item.name)}</span>");
      Put_Line (F, "      <b class=""category-percent"">${item.percent.toFixed(2)}%</b>");
      Put_Line (F, "      <strong class=""category-time"">${formatDuration(item.totalSeconds)}</strong>");
      Put_Line (F, "    </li>`)");
      Put_Line (F, "        .join("""");");
      Put_Line (F, "    return `");
      Put_Line (F, "    <article class=""dashboard-panel category-panel"">");
      Put_Line (F, "      <header class=""panel-heading"">");
      Put_Line (F, "        <div><p class=""panel-kicker"">05 / MISSION PROFILE</p><h2>Categories</h2></div>");
      Put_Line (F, "        <span class=""panel-meta"">TOP ${items.length}</span>");
      Put_Line (F, "      </header>");
      Put_Line (F, "      ${items.length");
      Put_Line (F, "        ? `");
      Put_Line (F, "        <div class=""category-layout"">");
      Put_Line (F, "          <div class=""category-ring"" style=""--category-gradient: ${categoryGradient(items)}"" role=""img"" aria-label=""Category distribution ring"">");
      Put_Line (F, "            <div><span>TIME</span><strong>LOG</strong></div>");
      Put_Line (F, "          </div>");
      Put_Line (F, "          <ol class=""category-list"">${legend}</ol>");
      Put_Line (F, "        </div>`");
      Put_Line (F, "        : '<p class=""empty-data"">No category activity was reported for this range.</p>'}");
      Put_Line (F, "    </article>`;");
      Put_Line (F, "}");
      Put_Line (F, "function dashboardMarkup(data) {");
      Put_Line (F, "    return `");
      Put_Line (F, "    ${languageMarkup(data.languages)}");
      Put_Line (F, "    ${editorMarkup(data.editors)}");
      Put_Line (F, "    <div class=""dashboard-side-stack"">");
      Put_Line (F, "      ${systemsMarkup(data.systems)}");
      Put_Line (F, "      ${categoriesMarkup(data.categories)}");
      Put_Line (F, "    </div>`;");
      Put_Line (F, "}");
      Put_Line (F, "const getElement = (selector) => {");
      Put_Line (F, "    const element = document.querySelector(selector);");
      Put_Line (F, "    if (!element)");
      Put_Line (F, "        throw new Error(`Dashboard element ""${selector}"" was not found.`);");
      Put_Line (F, "    return element;");
      Put_Line (F, "};");
      Put_Line (F, "const connectionState = getElement("".connection-state"");");
      Put_Line (F, "const connectionLabel = getElement(""#connection-label"");");
      Put_Line (F, "const refreshButton = getElement(""#refresh-button"");");
      Put_Line (F, "const refreshLabel = getElement("".refresh-label"");");
      Put_Line (F, "const refreshIcon = getElement("".refresh-icon"");");
      Put_Line (F, "const summaryGrid = getElement(""#summary-grid"");");
      Put_Line (F, "const feedMessage = getElement(""#feed-message"");");
      Put_Line (F, "const feedError = getElement(""#feed-error"");");
      Put_Line (F, "const retryButton = getElement(""#retry-button"");");
      Put_Line (F, "const loadingPanel = getElement(""#loading-panel"");");
      Put_Line (F, "const dashboardGrid = getElement(""#dashboard-grid"");");
      Put_Line (F, "const dashboardFooter = getElement(""#dashboard-footer"");");
      Put_Line (F, "let refreshing = false;");
      Put_Line (F, "let loadedDashboard = false;");
      Put_Line (F, "async function refreshDashboard() {");
      Put_Line (F, "    if (refreshing)");
      Put_Line (F, "        return;");
      Put_Line (F, "    refreshing = true;");
      Put_Line (F, "    refreshButton.disabled = true;");
      Put_Line (F, "    refreshIcon.classList.add(""spinning"");");
      Put_Line (F, "    refreshLabel.textContent = ""SYNCING"";");
      Put_Line (F, "    feedMessage.hidden = true;");
      Put_Line (F, "    connectionState.classList.remove(""online"");");
      Put_Line (F, "    if (loadedDashboard)");
      Put_Line (F, "        connectionLabel.textContent = ""SYNCING"";");
      Put_Line (F, "    try {");
      Put_Line (F, "        const data = await loadDashboard();");
      Put_Line (F, "        summaryGrid.innerHTML = summaryMarkup(data.summary);");
      Put_Line (F, "        summaryGrid.hidden = false;");
      Put_Line (F, "        dashboardGrid.innerHTML = dashboardMarkup(data);");
      Put_Line (F, "        dashboardGrid.hidden = false;");
      Put_Line (F, "        dashboardFooter.innerHTML = `");
      Put_Line (F, "      <span>WAKATIME PUBLIC SHARE FEED <span class=""footer-divider"">/</span> REFRESHED ON LOAD &amp; EVERY 15 MIN <span class=""footer-divider"">/</span> UNMAPPED RUNTIME = WAKATIME “OTHER”</span>");
      Put_Line (F, "      <time datetime=""${new Date().toISOString()}"">LAST SYNC ${escapeHtml(new Date().toLocaleTimeString())}</time>`;");
      Put_Line (F, "        dashboardFooter.hidden = false;");
      Put_Line (F, "        loadingPanel.hidden = true;");
      Put_Line (F, "        connectionState.classList.add(""online"");");
      Put_Line (F, "        connectionLabel.textContent = ""LIVE FEED"";");
      Put_Line (F, "        loadedDashboard = true;");
      Put_Line (F, "    }");
      Put_Line (F, "    catch (cause) {");
      Put_Line (F, "        const message = cause instanceof Error ? cause.message : ""Unable to load WakaTime data."";");
      Put_Line (F, "        feedError.textContent = message;");
      Put_Line (F, "        feedMessage.hidden = false;");
      Put_Line (F, "        connectionState.classList.remove(""online"");");
      Put_Line (F, "        connectionLabel.textContent = loadedDashboard ? ""STALE FEED"" : ""OFFLINE"";");
      Put_Line (F, "        if (!loadedDashboard)");
      Put_Line (F, "            loadingPanel.hidden = true;");
      Put_Line (F, "    }");
      Put_Line (F, "    finally {");
      Put_Line (F, "        refreshing = false;");
      Put_Line (F, "        refreshButton.disabled = false;");
      Put_Line (F, "        refreshIcon.classList.remove(""spinning"");");
      Put_Line (F, "        refreshLabel.textContent = ""SYNC"";");
      Put_Line (F, "    }");
      Put_Line (F, "}");
      Put_Line (F, "refreshButton.addEventListener(""click"", () => void refreshDashboard());");
      Put_Line (F, "retryButton.addEventListener(""click"", () => void refreshDashboard());");
      Put_Line (F, "void refreshDashboard();");
      Put_Line (F, "window.setInterval(() => void refreshDashboard(), 15 * 60 * 1000);");
      Close (F);
   end Emit_JS;
end Telemetry_Client;
