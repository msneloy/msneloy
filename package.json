{
  "name": "msneloy-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "npm run build:render",
    "build:cloudflare": "cross-env DEPLOY_TARGET=cloudflare vite build",
    "build:netlify": "cross-env DEPLOY_TARGET=netlify vite build",
    "build:render": "cross-env DEPLOY_TARGET=render vite build",
    "build:vercel": "cross-env DEPLOY_TARGET=vercel vite build",
    "start": "node build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/adapter-netlify": "^7.0.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/adapter-vercel": "^7.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.4",
    "@types/node": "^26.6.4",
    "cross-env": "^10.1.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.4.4",
    "typescript": "^6.0.0",
    "vite": "^8.0.12",
    "wrangler": "^4.147.0"
  }
}
